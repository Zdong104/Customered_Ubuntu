#!/bin/bash
# Per-user half of preload, run by the preload-user-sync user service at every
# login (and by preload-update right after an update, for logged-in users).
# Accounts that existed before preload never got /etc/skel, and enabling an
# extension is a per-user setting, so:
#   1. copy preload's /etc/skel files the user does NOT have (never overwrite);
#   2. enable preload's default extensions that are new to this user.
# Each file / extension is offered once (remembered in
# ~/.local/state/preload), so deleting a file or disabling an extension
# yourself sticks.
set -u
MAN=/var/lib/preload/state/manifest/files
S=${XDG_STATE_HOME:-$HOME/.local/state}/preload
mkdir -p "$S"
touch "$S/skel-offered" "$S/extensions-offered"

# 1. skel files
if [ -r "$MAN" ]; then
    grep '^etc/skel/' "$MAN" | while IFS= read -r f; do
        rel=${f#etc/skel/}
        grep -qxF "$rel" "$S/skel-offered" && continue
        if [ -f "/$f" ] && [ ! -e "$HOME/$rel" ] && [ ! -L "$HOME/$rel" ]; then
            mkdir -p "$(dirname "$HOME/$rel")" && cp "/$f" "$HOME/$rel" && echo "added ~/$rel"
        fi
        echo "$rel" >> "$S/skel-offered"
    done
fi

# 1b. one-time migrations of files an earlier release's skel gave the user.
# Vocalinux: the "auto" text-injection backend (the desktop portal) drops
# Chinese text; preload now defaults to "ydotool". Only a config that still says
# "auto" is changed, and never while Vocalinux runs (it keeps its settings in
# memory and could write "auto" back): then, or while there is no config yet,
# it is retried at the next login. Done once per user.
VC=${XDG_CONFIG_HOME:-$HOME/.config}/vocalinux/config.json
if ! grep -qxF vocalinux-ydotool "$S/migrations" 2>/dev/null && [ -f "$VC" ] &&
   ! pgrep -u "$(id -u)" -f '/opt/vocalinux/' >/dev/null 2>&1; then
    python3 - "$VC" <<'PY' && echo vocalinux-ydotool >> "$S/migrations"
import json, os, sys
p = sys.argv[1]
try:
    with open(p) as f:
        cfg = json.load(f)
except (OSError, ValueError):
    sys.exit(0)                 # unreadable: leave it alone for good
ti = cfg.get("text_injection")
if isinstance(ti, dict) and ti.get("backend") == "auto":
    ti["backend"] = "ydotool"
    tmp = p + ".preload-new"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, p)
    print("vocalinux: text_injection.backend auto -> ydotool")
PY
fi

# fcitx5: releases up to v2026.11.09 gave new users a classicui.conf with the
# stock "default" / "default-dark" themes; preload now ships macOS-style
# mac-light / mac-dark. A file that still names both stock themes is switched
# (once per user); a user who picked any other theme keeps it.
FC=${XDG_CONFIG_HOME:-$HOME/.config}/fcitx5/conf/classicui.conf
if ! grep -qxF fcitx5-mac-theme "$S/migrations" 2>/dev/null; then
    if [ -f "$FC" ] && grep -qx 'Theme=default' "$FC" && grep -qx 'DarkTheme=default-dark' "$FC" &&
       [ -d /usr/share/fcitx5/themes/mac-light ] && [ -d /usr/share/fcitx5/themes/mac-dark ]; then
        sed -i -e 's/^Theme=default$/Theme=mac-light/' -e 's/^DarkTheme=default-dark$/DarkTheme=mac-dark/' \
            -e 's/^UseAccentColor=True$/UseAccentColor=False/' \
            -e 's/^# Use the GNOME accent colour for the highlighted candidate\.$/# macOS-style blue highlight (mac-light \/ mac-dark themes) instead of the GNOME accent colour./' \
            "$FC" && echo "fcitx5: candidate theme default -> mac-light / mac-dark"
        # a running fcitx5 picks it up now, otherwise at its next start
        gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
            --method org.fcitx.Fcitx.Controller1.ReloadConfig >/dev/null 2>&1 || true
    fi
    echo fcitx5-mac-theme >> "$S/migrations"
fi

# 2. extensions: the preload default list (schema default + override, read via
# the memory backend so the user's own value does not mask it), minus what
# was offered before; installed system-wide ones only.
command -v gsettings >/dev/null || exit 0
default=$(GSETTINGS_BACKEND=memory gsettings get org.gnome.shell enabled-extensions 2>/dev/null) || exit 0
current=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null) || exit 0
disabled=$(gsettings get org.gnome.shell disabled-extensions 2>/dev/null || echo '@as []')
python3 - "$default" "$current" "$disabled" "$S/extensions-offered" <<'PY' || exit 0
import ast, os, subprocess, sys

def parse(v):
    v = v.strip()
    if v.startswith("@as"):
        v = v[3:].strip()
    return list(ast.literal_eval(v)) if v else []

default, current, disabled = (parse(a) for a in sys.argv[1:4])
offered_path = sys.argv[4]
offered = set(open(offered_path).read().split())
new = [u for u in default
       if u not in offered and os.path.isdir(f"/usr/share/gnome-shell/extensions/{u}")]
add = [u for u in new if u not in current]
if add:
    subprocess.run(["gsettings", "set", "org.gnome.shell", "enabled-extensions", str(current + add)], check=True)
    keep = [u for u in disabled if u not in add]
    if keep != disabled:
        subprocess.run(["gsettings", "set", "org.gnome.shell", "disabled-extensions", str(keep)], check=True)
    print("enabled extensions:", " ".join(add))
with open(offered_path, "a") as f:
    for u in new:
        f.write(u + "\n")
PY
exit 0
